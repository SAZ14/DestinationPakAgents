# =============================================================================
# Asaan Intelligence — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Server ---
PORT=3000
# Public base URL of this server (used when building Twilio webhook URLs / logs).
# In dev this is typically your ngrok / tunnel URL, e.g. https://abcd.ngrok.io
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated. Optional: skip Twilio signature validation in local dev only.
# Leave empty / "false" in production.
SKIP_TWILIO_SIGNATURE_VALIDATION=false

# --- Supabase (Postgres) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key — server-side only. Has full DB access; keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio WhatsApp ---
# Build against the Twilio Sandbox first. To go to production, change
# TWILIO_WHATSAPP_FROM to your approved sender — no code changes required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default is: whatsapp:+14155238886
# Production: whatsapp:+<your approved number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Model used for qualification, drafting, segmentation, command parsing.
# Default is the most capable widely-released model.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Staff approvers ---
# Comma-separated WhatsApp numbers (E.164, with the whatsapp: prefix) that are
# allowed to approve quotes/follow-ups and run admin commands. These are seeded
# into the `staff` table, but this env var is the source of truth for auth.
# Example: whatsapp:+923001234567,whatsapp:+923009876543
STAFF_APPROVER_NUMBERS=

# --- Business defaults (Destination Pakistan specific) ---
# Currency is fixed to USD for the v1 catalog.
DEFAULT_CURRENCY=USD
