# Chief of Staff Agent — environment variables.
# Every value has an offline default; with NONE of these set the service runs in
# fully-mocked mode (deterministic classifier/orchestrator, in-memory data,
# logged-only outbound). Set them to go live.

# --- Anthropic (Haiku classify + Sonnet orchestrate) ---
ANTHROPIC_API_KEY=
COS_CLASSIFIER_MODEL=claude-haiku-4-5
COS_ORCHESTRATOR_MODEL=claude-sonnet-4-6

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp number this tenant's owner texts (resolves tenant_id).
DP_TWILIO_NUMBER=+14155238886
# Comma-separated owner/staff whitelist (fail-closed). E.164, with or without whatsapp:
DP_OWNER_NUMBERS=+923001112233,+923004445566

# --- Apify (competitor scraping) ---
APIFY_TOKEN=
APIFY_IG_ACTOR=apify/instagram-scraper

# --- Behaviour ---
COS_PENDING_TTL_MINUTES=30
# Asaanpay deposit-link generation is the open dependency. Flip to true only
# once the per-lead pay-link step is wired; until then deposit pushes draft
# without a link and the agent says so.
COS_ASAANPAY_ENABLED=false
